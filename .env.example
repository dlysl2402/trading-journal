# MetaApi credentials. The account id is the UUID MetaApi assigns, not the MT5
# login number, and the region is part of the API hostname.
#
# METAAPI_ACCESS_TOKEN must be an API token from the MetaApi dashboard: a JWT,
# several hundred characters, beginning "eyJ".
#
# The MetaApi account itself must be configured with the MT5 *investor*
# password. It is read-only and revocable, and `npm run update` warns on every
# run if MetaApi reports it is holding the master password instead.
METAAPI_ACCOUNT_ID=
METAAPI_ACCESS_TOKEN=
METAAPI_REGION=london

# Supabase, where the record lives. Both are under Project Settings → API.
# The key must be the project's *secret* key (sb_secret_…, or the legacy
# service_role key): it bypasses row-level security so the import can write
# the broker tables the UI may only read. It never leaves this file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
